const B='http://localhost:3947'; let cookie='';
async function call(p,{method='GET',body}={}){const h={};if(body!==undefined){h['content-type']='application/json';method=method==='GET'?'POST':method;}if(cookie)h.cookie=cookie;const r=await fetch(B+p,{method,headers:h,body:body!==undefined?JSON.stringify(body):undefined});const sc=r.headers.get('set-cookie');if(sc)cookie=sc.split(';')[0];const t=await r.text();let j=null;try{j=JSON.parse(t);}catch{}return{status:r.status,json:j,t};}
let pass=0,fail=0;const ok=(c,m)=>{c?pass++:fail++;console.log(c?'PASS':'FAIL',m);};
await call('/api/login',{body:{email:'admin@geekitek.test',password:'admin123'}});
const acct=(await call('/api/meta')).json.accounts[0];

// 1 customer delete now blocked when billing exists
const c=(await call('/api/customers',{method:'POST',body:{name:'Guard Test',account_ids:[acct.id]}})).json;
await call('/api/billing/invoices',{method:'POST',body:{customer_id:c.id,date:'2026-01-01',tax_rate:0,items:[{description:'x',quantity:1,unit_price:10,taxable:0}]}});
let d=await call('/api/customers/'+c.id,{method:'DELETE'});
ok(d.status===409 && /invoice/.test(d.json.error),'delete blocked w/ invoices: '+d.json.error);
// ticket blocks too
const c2=(await call('/api/customers',{method:'POST',body:{name:'Guard Tix',account_ids:[acct.id]}})).json;
await call('/api/tickets',{method:'POST',body:{customer_id:c2.id,subject:'t'}});
d=await call('/api/customers/'+c2.id,{method:'DELETE'});
ok(d.status===409&&/ticket/.test(d.json.error),'delete blocked w/ tickets');
// clean customer still deletable
const c3=(await call('/api/customers',{method:'POST',body:{name:'Clean',account_ids:[acct.id]}})).json;
ok((await call('/api/customers/'+c3.id,{method:'DELETE'})).status===200,'clean customer still deletable');

// 2 circuit self-loop rejected
const sites=(await call('/api/sites')).json;
ok((await call('/api/circuits',{method:'POST',body:{a_type:'site',a_ref_id:sites[0].id,z_type:'site',z_ref_id:sites[0].id}})).status===400,'circuit self-loop rejected');
ok((await call('/api/circuits',{method:'POST',body:{a_type:'site',a_ref_id:sites[0].id,z_type:'site',z_ref_id:sites[1].id}})).status===200,'valid circuit still allowed');

// 3 negative costs clamped
const sa=(await call('/api/accounts/'+acct.id+'/subaccounts',{method:'POST',body:{name:'Neg',monthly_cost:'-500'}})).json;
const p=(await call('/api/accounts/'+acct.id+'/pnl')).json;
ok(p.sub_cost===0,'negative sub-account cost clamped to 0 (was '+p.sub_cost+')');
await call('/api/accounts/'+acct.id,{method:'PUT',body:{name:acct.name,monthly_cost:'-100'}});
ok((await call('/api/accounts/'+acct.id+'/pnl')).json.base_cost===0,'negative account cost clamped');

// 4 login throttle
cookie='';
let last=null; for(let i=0;i<12;i++) last=await call('/api/login',{body:{email:'admin@geekitek.test',password:'wrong'}});
ok(last.status===429,'staff login throttled after repeated failures ('+last.status+')');
// legit login from same key now blocked -> confirms throttle active; use different identity to prove per-key
const other=await call('/api/login',{body:{email:'noc@geekitek.test',password:'noc123'}});
ok(other.status===200,'throttle is per-identity, not global (other user can still log in)');
console.log('\nRESULT:',pass,'passed,',fail,'failed');process.exit(fail?1:0);
