const B='http://localhost:3961'; let cookie='';
async function call(p,{method='GET',body}={}){const h={};if(body!==undefined){h['content-type']='application/json';method=method==='GET'?'POST':method;}if(cookie)h.cookie=cookie;const r=await fetch(B+p,{method,headers:h,body:body!==undefined?JSON.stringify(body):undefined});const sc=r.headers.get('set-cookie');if(sc)cookie=sc.split(';')[0];const t=await r.text();let j=null;try{j=JSON.parse(t);}catch{}return{status:r.status,json:j,t};}
let pass=0,fail=0;const ok=(c,m)=>{c?pass++:fail++;console.log(c?'PASS':'FAIL',m);};
await call('/api/login',{body:{email:'admin@geekitek.test',password:'admin123'}});
const all=(await call('/api/circuits')).json;
ok(all.length===2,'idempotent: still 2 circuits after 2nd reboot (got '+all.length+')');
const acctCk=all.find(c=>c.a_type==='account');
ok(acctCk&&acctCk.a_name==='Acme Logistics','account endpoint resolves name: '+(acctCk&&acctCk.a_name));
ok(acctCk&&acctCk.a_href==='#/account/1','account endpoint links to account page');
// options include accounts
const o=(await call('/api/circuits-options')).json;
ok(Array.isArray(o.accounts)&&o.accounts.length>0,'circuits-options exposes accounts');
// POP page no longer returns pop_circuits
const pops=(await call('/api/pops')).json;
const pop=(await call('/api/pops/'+pops[0].id)).json;
ok(pop.circuits===undefined,'POP GET no longer returns legacy .circuits');
// ref filter surfaces the merged upstream on the POP
const byPop=(await call('/api/circuits?ref=pop:'+pops[0].id)).json;
ok(byPop.length===2,'POP ref filter shows both merged circuits ('+byPop.length+')');
// old endpoints gone
ok((await call('/api/pops/'+pops[0].id+'/circuits',{method:'POST',body:{source_type:'pop',source_pop_id:2}})).status===404,'legacy POST /api/pops/:id/circuits removed (404)');
// create via new API with account endpoint
const r=await call('/api/circuits',{method:'POST',body:{a_type:'account',a_ref_id:1,z_type:'pop',z_ref_id:pops[0].id,circuit_id:'NEW-1',bandwidth:'500M'}});
ok(r.status===200,'can create account->pop circuit via unified API');
// account<->account rejected (neither end internal)
ok((await call('/api/circuits',{method:'POST',body:{a_type:'account',a_ref_id:1,z_type:'carrier',z_ref_id:1}})).status===400,'account<->carrier rejected (no internal end)');
// patch panel circuit dropdown for POP now uses circuits
const pc=(await call('/api/patch/pop/'+pops[0].id)).json;
ok(pc.circuits.length>=2,'patch panel POP circuit options come from circuits ('+pc.circuits.length+')');
// connection -> circuit link
const sites=(await call('/api/sites')).json;
const conn=await call('/api/sites/'+sites[0].id+'/connections',{method:'POST',body:{role:'Primary',served_type:'pop',served_pop_id:pops[0].id,circuit_ref_id:all[0].id,bandwidth:'1G'}});
const sf=(await call('/api/sites/'+sites[0].id)).json;
const linked=sf.connections.find(c=>c.circuit_ref_id===all[0].id);
ok(linked&&linked.circuit&&linked.circuit.id===all[0].id,'site connection links to a circuit record');
console.log('\nRESULT:',pass,'passed,',fail,'failed');process.exit(fail?1:0);
