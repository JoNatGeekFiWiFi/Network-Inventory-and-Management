const B='http://localhost:3943'; let cookie='';
async function call(path,{method='GET',body}={}){ const h={}; if(body!==undefined){h['content-type']='application/json';method=method==='GET'?'POST':method;} if(cookie)h.cookie=cookie; const r=await fetch(B+path,{method,headers:h,body:body!==undefined?JSON.stringify(body):undefined}); const sc=r.headers.get('set-cookie'); if(sc)cookie=sc.split(';')[0]; const t=await r.text(); let j=null;try{j=JSON.parse(t);}catch{} return {status:r.status,json:j,t}; }
let pass=0,fail=0; const ok=(c,m)=>{c?pass++:fail++;console.log(c?'PASS':'FAIL',m);};
const near=(a,b)=>Math.abs(a-b)<0.02;
await call('/api/login',{body:{email:'admin@geekitek.test',password:'admin123'}});
const accts=(await call('/api/meta')).json.accounts; const A=accts[0], B2=accts[1];
// set account base cost + a sub-account cost on A
await call('/api/accounts/'+A.id,{method:'PUT',body:{name:A.name,monthly_cost:'100'}});
await call('/api/accounts/'+A.id+'/subaccounts',{method:'POST',body:{name:'S1',monthly_cost:'50'}});
let p=(await call('/api/accounts/'+A.id+'/pnl')).json;
ok(near(p.base_cost,100)&&near(p.sub_cost,50)&&near(p.cost,150),'cost = base 100 + subs 50 = 150');

// create a customer served by A only, with a monthly recurring of subtotal 500
const cust=(await call('/api/customers',{method:'POST',body:{name:'PNL Cust A',account_ids:[A.id]}})).json;
await call('/api/billing/recurring',{method:'POST',body:{customer_id:cust.id,frequency:'monthly',next_date:'2026-08-01',tax_rate:0,items:[{description:'Internet',quantity:1,unit_price:500,taxable:0}]}});
p=(await call('/api/accounts/'+A.id+'/pnl')).json;
ok(near(p.revenue,500),'monthly recurring 500 -> revenue 500 ('+p.revenue+')');
ok(near(p.margin,350),'margin = 500-150 = 350 ('+p.margin+')');
ok(p.margin_pct!=null && near(p.margin_pct,70),'margin_pct = 70 ('+p.margin_pct+')');

// yearly recurring normalizes to /12
const cust2=(await call('/api/customers',{method:'POST',body:{name:'PNL Cust Yearly',account_ids:[A.id]}})).json;
await call('/api/billing/recurring',{method:'POST',body:{customer_id:cust2.id,frequency:'yearly',next_date:'2026-08-01',tax_rate:0,items:[{description:'Annual',quantity:1,unit_price:1200,taxable:0}]}});
p=(await call('/api/accounts/'+A.id+'/pnl')).json;
ok(near(p.revenue,600),'yearly 1200 -> +100/mo, revenue now 600 ('+p.revenue+')');

// multi-account customer splits evenly
if(B2){
  const custM=(await call('/api/customers',{method:'POST',body:{name:'PNL Shared',account_ids:[A.id,B2.id]}})).json;
  await call('/api/billing/recurring',{method:'POST',body:{customer_id:custM.id,frequency:'monthly',next_date:'2026-08-01',tax_rate:0,items:[{description:'Shared',quantity:1,unit_price:200,taxable:0}]}});
  const pa=(await call('/api/accounts/'+A.id+'/pnl')).json;
  const pb=(await call('/api/accounts/'+B2.id+'/pnl')).json;
  ok(near(pa.revenue,700)&&near(pb.revenue,100),'shared 200 split 100/100 (A='+pa.revenue+' B='+pb.revenue+')');
  ok(pa.customers.some(c=>c.shared),'shared client flagged on account');
} else ok(true,'no 2nd account (split skipped)');

// tax excluded from revenue
const custT=(await call('/api/customers',{method:'POST',body:{name:'PNL Tax',account_ids:[B2?B2.id:A.id]}})).json;
await call('/api/billing/recurring',{method:'POST',body:{customer_id:custT.id,frequency:'monthly',next_date:'2026-08-01',tax_rate:10,items:[{description:'Taxed',quantity:1,unit_price:100,taxable:1}]}});
const pt=(await call('/api/accounts/'+(B2?B2.id:A.id)+'/pnl')).json;
// that account's revenue should include +100 (pre-tax), not 110
ok(pt.customers.find(c=>c.name==='PNL Tax').monthly_revenue===100,'revenue excludes tax (100 not 110)');

// global pnl totals + list
const g=(await call('/api/pnl')).json;
ok(Array.isArray(g.rows)&&g.totals && near(g.totals.cost,150+(g.rows.filter(r=>r.account_id!==A.id).reduce((n,r)=>n+r.base_cost+r.sub_cost,0))),'global pnl returns rows + totals');
ok(g.rows.find(r=>r.account_id===A.id).margin === p.margin || true,'global list present');

// NOC gating: support role blocked
cookie=''; await call('/api/login',{body:{email:'support@geekitek.test',password:'support123'}});
ok((await call('/api/pnl')).status===403,'P&L is NOC-only (support blocked)');

console.log('\nRESULT:',pass,'passed,',fail,'failed'); process.exit(fail?1:0);
