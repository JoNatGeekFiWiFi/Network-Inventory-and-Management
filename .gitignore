# Dependencies
node_modules/

# Database files (created at runtime)
*.db
*.db-shm
*.db-wal
data.db

# Local helper / env
push-to-github.sh
.env
*.log

# Stray git lock files
*.lock

# Scratch test files (sandbox can't delete from the mounted folder)
/_*.mjs

# FUSE artifacts leaked by the sandbox mount
.fuse_hidden*

# IQGeo/myWorld exports — carrier + customer data, never commit these
myw_report_*.json
az_spans_*.json
*.myw.json

# Filled-in carrier import sheets — real accounts, addresses and portal credentials
*import-ready*.xlsx
*accounts-filled*.xlsx
/private/

# Raw device captures and probes. These come off live customer routers and contain the things that
# makes them identifiable: the customer's SSID, every connected client's MAC, the public IP the
# carrier assigned. The anonymised extract under test/fixtures/ is what gets committed instead.
# Anchored to the repo root: an unanchored pattern also swallowed the anonymised fixture under
# test/fixtures/, which is the one file here that MUST be committed.
/capture-*.json
/katalyst-*.json
/probe-*.json
!test/fixtures/

# Test PDFs dropped in for inspection. Blank IRS forms are public, but the folder is a working
# area and a real signed contract must never be committed by accident.
*.pdf
!test/fixtures/*.pdf
# Blank government forms the platform fills in (public documents, needed at runtime).
!forms/*.pdf

# Runtime data written next to data.db: uploaded files (visitor ID photos, signed contracts,
# attachments) and router config backups (full device configs, often with credentials). *.pdf above
# only covered the PDFs; an ID photo is a .jpg and a backup is a .rsc, and push-to-github.sh runs
# `git add -A`, so without these lines the next push after local testing would have published them.
/uploads/
/backups/
